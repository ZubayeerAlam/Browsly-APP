# Copy this file to supabase/functions/.env. Git ignores the copy.
# Must match the moderation_secret that seed_dev.sql puts in the database Vault.
MODERATION_SECRET=local-dev-moderation-secret
# For local testing without a key: "fake" uses the title rules in providers.ts.
# NEVER set this in production, because the fake AI approves almost everything.
MODERATION_PROVIDER=fake
# To test the real AI, remove MODERATION_PROVIDER and set these:
# GEMINI_API_KEY=your-key-from-google-ai-studio
# GEMINI_MODEL=gemini-2.5-flash-lite
